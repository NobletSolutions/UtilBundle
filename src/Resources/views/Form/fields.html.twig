{% block datepicker_widget %}

    {{ block('form_widget_simple') }}
    <script type="text/javascript" > var picker = new Pikaday({field: document.getElementById({{ id|json_encode|raw }})}); </script>

{% endblock %}

{% block clockpicker_widget %}

{% set attr = attr|merge({class: (attr.class|default('') ~ ' gsClockPickerFields')|trim}) %}
<div {{ block('widget_container_attributes') }}>
  {{ form_widget(form.hour) }}{% if form.minute is defined %}:{{ form_widget(form.minute) }}{% endif %}
  {% if form.second is defined %}:{{ form_widget(form.second) }}{% endif %}
  {{ form_widget(form.meridian) }}
  {{ form_label(form.meridian) }}
</div>

{% endblock clockpicker_widget %}

{% block choice_widget_options %}

    {% for group_label, choice in options %}
        {% if choice is iterable %}
            <optgroup label="{{ choice_translation_domain is same as(false) ? group_label : group_label|trans({}, choice_translation_domain) }}">
                {% set options = choice %}
                {{ block('choice_widget_options') }}
            </optgroup>
        {% else %}
            {%set specialvalue = null %}
            {%if special_values is defined %}
                {% for v in special_values %}
                    {%if v.value == choice.value %}
                        {%set specialvalue = v.context %}
                    {%endif%}
                {%endfor%}
            {%endif%}
            <option value="{{ choice.value }}"{% if choice.attr %}{% with {attr: choice.attr} %}{{ block('attributes') }}{% endwith %}{% endif %}{% if choice is selectedchoice(value) %} selected="selected"{% endif %}{% if specialvalue is not null %} data-context-field="{{ specialvalue }}"{% endif %}>{{ choice_translation_domain is same as(false) ? choice.label : choice.label|trans(choice.labelTranslationParameters, choice_translation_domain) }}</option>
        {% endif %}
    {% endfor %}

{% endblock choice_widget_options %}

