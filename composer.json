{
    "name": "ns/util-bundle",
    "type": "symfony-bundle",
    "description": "Various Utility Services and Classes",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Nathanael David Noblet",
            "email": "nathanael@noblet.ca"
        },
        {
            "name": "Mark Woynarski",
            "email": "mark.woynarski@nobletdesign.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "doctrine/collections": "^1.8 || ^2.2",
        "doctrine/dbal": "^3.10",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^2.20 || ^3.5",
        "jms/translation-bundle": "^2.7",
        "symfony/config": "^6.4 || ^7.1",
        "symfony/dependency-injection": "^6.4 || ^7.1",
        "symfony/form": "^6.4 || ^7.1",
        "symfony/framework-bundle": "^6.4 || ^7.1",
        "symfony/http-foundation": "^6.4 || ^7.1",
        "symfony/http-kernel": "^6.4 || ^7.1",
        "symfony/options-resolver": "^6.4 || ^7.1",
        "symfony/routing": "^6.4 || ^7.1",
        "symfony/twig-bundle": "^6.4 || ^7.1",
        "symfony/validator": "^6.4 || ^7.1",
        "symfony/yaml": "^6.4 || ^7.1",
        "twig/twig": "^3.15"
    },
    "autoload": {
        "psr-4": {
            "NS\\UtilBundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NS\\UtilBundle\\Tests\\": "Tests"
        }
    },
    "require-dev": {
        "liip/rmt": "^1.9",
        "phpunit/phpunit": "^11.5"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0-dev"
        }
    }
}
